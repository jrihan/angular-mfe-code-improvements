{
  "compileOnSave": false,
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "useDefineForClassFields": false,
    "paths": {
      "@examples/example-component": [
        "src/app/components/example/example.component.ts"
      ],
      "@examples/example-caronte": [
        "src/app/components/example/example-caronte/example-caronte.component.ts"
      ],
      "@examples/example-analytics": [
        "src/app/components/example/example-mfe-analytics/example-mfe-analytics.component.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "exclude": [
    "cypress",
    "cypress.config.ts",
    "node_modules"
  ]
}